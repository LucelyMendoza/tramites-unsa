# ===== Copiar a .env (desarrollo) o configurar en el panel de Render (producción). NUNCA subir .env al repositorio. =====
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173            # URL pública del frontend (enlaces en correos)
CORS_ORIGINS=http://localhost:5173       # lista separada por comas
PUBLIC_API_URL=http://localhost:4000     # URL pública de esta API (solo almacenamiento local de desarrollo)

# --- Base de datos ---
# Desarrollo: vacío => PostgreSQL embebido (PGlite) en memoria. Con PGLITE_DIR=.data/pg se persiste en disco.
# Producción (OBLIGATORIO): cadena de conexión de PostgreSQL gestionado, con sslmode=require.
DATABASE_URL=
PGLITE_DIR=

# --- Autenticación ---
AUTH_MODE=dev                            # dev | firebase | hybrid (Google + cuentas de prueba; en producción SOLO firebase)
ALLOWED_EMAIL_DOMAINS=unsa.edu.pe        # dominios institucionales permitidos, separados por coma (validado en el backend)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=           # JSON de la cuenta de servicio en una línea (o base64 según docs/DESPLIEGUE.md)
DEV_AUTH_SECRET=dev-only-secret-change-me
DEV_TEST_ACCOUNTS_ENABLED=true

# --- Almacenamiento de archivos ---
STORAGE_DRIVER=local                     # local | r2  (en producción SOLO r2)
LOCAL_STORAGE_DIR=.data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=                             # opcional; por defecto https://<ACCOUNT_ID>.r2.cloudflarestorage.com
PRESIGN_UPLOAD_TTL_SECONDS=300
PRESIGN_DOWNLOAD_TTL_SECONDS=60
MAX_FILE_MB=5

# --- Correo transaccional ---
MAIL_PROVIDER=console                    # console | resend (en producción SOLO resend)
MAIL_FROM="Trámites UNSA <no-reply@tu-dominio.pe>"
RESEND_API_KEY=
MAIL_WORKER_INTERVAL_MS=15000
MAIL_MAX_ATTEMPTS=8

# --- Reglas institucionales (pendientes de confirmar; ver docs/REGLAS_PENDIENTES.md) ---
CUI_PATTERN=^\d+$
ACADEMIC_DIRECTORY=fixture               # none | fixture (en producción usar none hasta integrar el padrón real)
RETENTION_ATTACHMENTS_MONTHS=12

# --- Roles administrativos iniciales (únicamente desde el servidor) ---
BOOTSTRAP_SUPERADMINS=                   # correos separados por coma; se otorgan al arrancar
