# URL base de la API. Vacío en desarrollo (Vite hace proxy de /api a http://localhost:4000).
# En producción: https://tu-api.onrender.com
VITE_API_URL=

# Firebase (config PÚBLICA de la app web; no es secreto). Si está vacío, el frontend usa las cuentas de prueba del backend (solo AUTH_MODE=dev).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Dominio institucional (solo sugerencia visual para Google: parámetro hd). La validación real es en el backend.
VITE_HOSTED_DOMAIN=unsa.edu.pe
