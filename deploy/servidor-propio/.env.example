# ===== Servidor propio: copie a .env y complete. NUNCA suba .env al repositorio. =====

# --- Base de datos (contenedor local) ---
DB_PASSWORD=                                  # 32+ caracteres aleatorios:  openssl rand -base64 32

# --- URLs públicas (las del subdominio institucional) ---
APP_URL=https://tramites.unsa.edu.pe
PUBLIC_API_URL=https://tramites.unsa.edu.pe
CORS_ORIGINS=https://tramites.unsa.edu.pe

# --- Archivos en el disco del servidor ---
STORAGE_SIGNING_SECRET=                       # 48+ caracteres aleatorios:  openssl rand -base64 48
MAX_FILE_MB=10
PRESIGN_UPLOAD_TTL_SECONDS=300
PRESIGN_DOWNLOAD_TTL_SECONDS=60

# --- Inicio de sesión con Google (Firebase) — ver docs/GUIA_FIREBASE.md ---
ALLOWED_EMAIL_DOMAINS=unsa.edu.pe
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=                # JSON de la cuenta de servicio en UNA línea
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_HOSTED_DOMAIN=unsa.edu.pe

# --- Correo ---
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="Trámites UNSA <tramites@unsa.edu.pe>"

# --- Primer superadministrador (se otorga al arrancar) ---
BOOTSTRAP_SUPERADMINS=

# --- Reglas institucionales ---
ACADEMIC_DIRECTORY=none
RETENTION_ATTACHMENTS_MONTHS=12

# --- Certificado TLS (carpeta con fullchain.pem y privkey.pem) ---
TLS_DIR=./tls
